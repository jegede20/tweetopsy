# Optional: enables explicitly requested AI summaries and rewrites only.
# Keep this value on the server; never prefix it with NEXT_PUBLIC_.
GROQ_API_KEY=
# As of October 2026, Groq's Llama models are not available on the free tier.
# This is the current free-tier-compatible default; override only with a model
# enabled for your Groq account.
GROQ_MODEL=openai/gpt-oss-20b
